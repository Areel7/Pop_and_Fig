# =========================================================
# Pop & Figs — BACKEND environment (project root .env)
# Never commit the real .env. Never prefix these with VITE_.
# =========================================================

NODE_ENV=development
PORT=5000

# MongoDB (MONGO_URI is also accepted for backwards compatibility)
MONGODB_URI=mongodb://localhost:27017/popandfigs

# Long random string (32+ characters), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Storefront origin(s) allowed by CORS (comma separated) and used in email links
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for locally stored upload URLs)
SERVER_URL=http://localhost:5000
# Use "none" when the frontend and API are on different sites in production (requires HTTPS)
COOKIE_SAMESITE=lax

# Gmail API — the STORE OWNER's Gmail account, authorized once via OAuth 2.0 (see README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=popandfigs@gmail.com
GMAIL_SENDER_NAME=Pop & Figs
# Set to false after you have your refresh token to disable the setup routes
GMAIL_OAUTH_SETUP_ENABLED=true

# Optional: Cloudinary image hosting (local /uploads folder is used when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pop-and-figs

# First admin account (created on server start if it does not exist, or: npm run create-admin)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
