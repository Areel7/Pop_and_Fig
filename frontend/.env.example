# =========================================================
# Pop & Figs — FRONTEND environment (frontend/.env)
# Everything here is PUBLIC (bundled into the browser).
# Never put Gmail, JWT or Cloudinary secrets in VITE_ variables.
# =========================================================

# Backend origin. Leave empty in development to use the Vite proxy (/api -> http://localhost:5000).
# In production set it to the public API origin, e.g. https://api.popandfigs.com
VITE_API_URL=

# Dev proxy target (development only)
VITE_DEV_API_PROXY=http://localhost:5000

# EmailJS — contact form only (public key is safe to expose)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
