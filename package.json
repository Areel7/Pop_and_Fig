{
  "name": "popandfigs",
  "version": "1.0.0",
  "description": "Pop & Figs \u2014 full-stack e-commerce store (React + Express + MongoDB)",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "backend/index.js",
  "scripts": {
    "dev": "node init && concurrently -n api,web -c yellow,cyan \"npm run backend\" \"npm run frontend\"",
    "fullstack": "npm run dev",
    "frontend": "npm --prefix frontend run dev",
    "backend": "nodemon --watch backend backend/index.js",
    "start": "node init && node backend/index.js",
    "build": "node init && npm --prefix frontend run build",
    "create-admin": "node backend/Scripts/createAdmin.js",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemon": "^3.1.14",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
